# Raspberry Pi bootloader EEPROM tools + firmware images, packaged from
# raspberrypi/rpi-eeprom (ALARM doesn't carry it). Needed on-device to read
# and change BOOT_ORDER (USB/NVMe/eMMC priority) on Pi 5/CM5:
#
#   sudo rpi-eeprom-config --out /tmp/boot.conf
#   sudo sed -i 's/^BOOT_ORDER=.*/BOOT_ORDER=0xf164/' /tmp/boot.conf
#   sudo rpi-eeprom-config --apply /tmp/boot.conf   # applies on next reboot
#
# Pi 5 EEPROM updates are staged to the FAT boot partition and applied by the
# firmware at reboot — no flashrom needed.
pkgname=rpi-eeprom
pkgver=2026.05.11.2712
_tag=v2026.05.11-2712
pkgrel=1
pkgdesc="Raspberry Pi bootloader EEPROM update tools and firmware images"
arch=('aarch64')
url="https://github.com/raspberrypi/rpi-eeprom"
license=('BSD-3-Clause' 'custom:firmware')
depends=('python' 'bash')
optdepends=('raspberrypi-utils: vcgencmd used to query the running bootloader')
backup=('etc/default/rpi-eeprom-update')
source=("rpi-eeprom-$_tag.tar.gz::https://github.com/raspberrypi/rpi-eeprom/archive/refs/tags/$_tag.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/rpi-eeprom-${_tag#v}"
    install -Dm755 rpi-eeprom-update "$pkgdir/usr/bin/rpi-eeprom-update"
    install -Dm755 rpi-eeprom-config "$pkgdir/usr/bin/rpi-eeprom-config"
    install -Dm755 rpi-eeprom-digest "$pkgdir/usr/bin/rpi-eeprom-digest"

    # Pi 5 / CM5 (BCM2712) firmware images
    install -d "$pkgdir/usr/lib/firmware/raspberrypi/bootloader-2712"
    cp -a firmware-2712/* "$pkgdir/usr/lib/firmware/raspberrypi/bootloader-2712/"

    # Arch layout defaults: FAT boot partition at /boot, stable release channel
    install -Dm644 /dev/stdin "$pkgdir/etc/default/rpi-eeprom-update" <<'EOF'
FIRMWARE_RELEASE_STATUS="default"
BOOTFS=/boot
CM4_ENABLE_RPI_EEPROM_UPDATE=1
EOF

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}

# Pi/CM5 additions on top of upstream's base list. The boot-chain packages
# (kernel, firmware) are installed explicitly in build/mkimage.sh before this
# list; this is the userspace side.

# VideoCore VII graphics: GLES via mesa, Vulkan via v3dv
mesa
vulkan-broadcom

# libcamera stack for CSI cameras on the carrier
libcamera

# The x86 ISO installs these via archinstall/early-bootstrap (base-devel,
# sudo for the wheel user, makepkg for yay/AUR flows); our builder must add
# them explicitly — omarchy-base.packages assumes they're already present.
sudo
base-devel

# omarchy-cm5-install-to-disk clones the running system onto eMMC/NVMe;
# its disk machinery (forked from omarchy-iso) drives parted.
rsync
parted

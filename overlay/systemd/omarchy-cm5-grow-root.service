[Unit]
Description=Grow root partition to fill the boot medium (first boot)
ConditionPathExists=!/var/lib/omarchy-cm5/root-grown
DefaultDependencies=no
After=systemd-remount-fs.service
Before=systemd-sysusers.service sysinit.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/omarchy-cm5-grow-root

[Install]
WantedBy=multi-user.target
